{
  "name": "d2-armor-solver",
  "version": "3.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --target x86_64-pc-windows-msvc -- --locked",
    "desktop:ui": "vite --config desktop/vite.config.mjs",
    "desktop:frontend": "tsc -p desktop/tsconfig.json && vite build --config desktop/vite.config.mjs",
    "desktop:test": "npm run desktop:frontend && node scripts/verify-desktop.mjs",
    "build": "node scripts/build.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "dev:cloudflare": "npm run build && wrangler dev",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test",
    "test:upgrade": "node check-upgrade-plan.js",
    "test:consistency": "node --test tests/witness-consistency.test.mjs tests/v3-differential.test.mjs",
    "benchmark:v3": "node scripts/benchmark-solver-v3.mjs",
    "benchmark:v3-client": "node scripts/benchmark-v3-client.mjs",
    "benchmark:inventory": "node scripts/benchmark-v3-realistic.mjs",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "verify:offline": "node scripts/build-offline.mjs && node scripts/verify-offline.mjs",
    "check": "npm run lint && npm run test && npm run test:upgrade && npm run build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.8.0",
    "globals": "^17.3.0",
    "playwright-core": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
